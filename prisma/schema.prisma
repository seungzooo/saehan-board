// 출고/재고보드 데이터 모델 — CLAUDE.md "데이터 모델" 섹션 기준
// PostgreSQL (Supabase). 런타임은 DATABASE_URL(트랜잭션 풀러), 마이그레이션은 DIRECT_URL(세션 풀러)

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// 제품 마스터. 판매실적 엑셀에서 distinct로 생성, 제품 마스터 엑셀로 갱신
model Product {
  code        String  @id
  name        String
  itemType    String? // 품 종 (예: TSA00450P1)
  capacity    String? // 용량 (예: "2L", "450")
  packUnit    String  @default("박스") // 포장단위: 박스/파렛트/83*155/필름 …
  unitsPerBox Int     @default(1) // 포장단위수량 (박스당 입수)
  category    String? // 품번 접두어: TM/TR=PET1팀, EM=PE팀, FM=PET2팀, AM/TY/WM=사입
  isProduced  Boolean @default(false) // 생산실적에도 있는 품번 (F5 상관분석 대상)
  boxW        Int? // mm — 규격 받기 전 null
  boxD        Int?
  boxH        Int?
  volumeM3    Float?
  isActive    Boolean @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  snapshots   StockSnapshot[]
  adjustments StockAdjustment[]
  productions ProductionHistory[]
  shipments   ShipmentHistory[]
  monthly     MonthlyStat[]
}

/// 엑셀 업로드 1회 = 1 batch. fileHash로 같은 파일 재업로드 감지
model UploadBatch {
  id            String    @id @default(cuid())
  kind          String // STOCK | SALES | PRODUCTION | PRODUCT | CUSTOMER
  fileName      String
  fileHash      String    @unique
  rowCount      Int
  uploadedAt    DateTime  @default(now()) // 앱에 반영된 시각
  uploadedBy    String
  stockAsOf     DateTime? // (STOCK) 파일의 집계 기준 시각. 담당자 입력, 없으면 "집계 시각 미확인"
  defectApplied Boolean   @default(false) // (STOCK) 파일에 사후 불량이 반영되어 있음 → 이전 불량 차감 리셋

  snapshots   StockSnapshot[]
  productions ProductionHistory[]
  shipments   ShipmentHistory[]
}

/// 기초재고 스냅샷. 같은 batchId를 공유하는 행들이 한 번의 업로드
model StockSnapshot {
  id          Int       @id @default(autoincrement())
  productCode String
  qtyBox      Int
  uploadedAt  DateTime  @default(now()) // 반영 시각
  stockAsOf   DateTime? // 집계 기준 시각 (batch와 동일 값, 조회 편의)
  uploadedBy  String
  batchId     String

  product Product     @relation(fields: [productCode], references: [code])
  batch   UploadBatch @relation(fields: [batchId], references: [id])

  @@index([productCode, uploadedAt])
  @@index([batchId])
}

/// 변동 입력(F2). 취소는 삭제가 아니라 cancelledAt 기록
model StockAdjustment {
  id          Int       @id @default(autoincrement())
  productCode String
  qtyBox      Int
  reason      String // DEFECT | SHIPMENT | ORDER | OTHER
  memo        String?
  createdBy   String
  createdAt   DateTime  @default(now())
  cancelledAt DateTime?

  product Product @relation(fields: [productCode], references: [code])

  @@index([productCode, createdAt])
}

/// ERP 생산실적. 전표구분 32(재가공투입)는 생산이 아니므로 집계 시 제외
/// 중복 키: (date, productCode, workOrderNo, shift, machine, slipType) — 재업로드 시 같은 행은 건너뜀
model ProductionHistory {
  id          Int      @id @default(autoincrement())
  productCode String
  date        DateTime
  yearMonth   String // YYYY-MM (월별 집계용)
  dept        String? // 생산부서 (1211 PET 1팀 …)
  shift       String? // 작업조 A/B/C
  machine     String? // 생산호기
  workOrderNo String? // 작업지시번호
  slipType    String // 전표구분 코드: 21 본가공입고 / 22 재가공입고 / 32 재가공투입
  unitsPerBox Int?
  qtyGood     Int // 수량(A급)
  qtyDefect   Int // 수량(C급)
  batchId     String?

  product Product      @relation(fields: [productCode], references: [code])
  batch   UploadBatch? @relation(fields: [batchId], references: [id])

  @@unique([date, productCode, workOrderNo, shift, machine, slipType])
  @@index([productCode, date])
  @@index([date])
  @@index([yearMonth])
}

/// ERP 판매(출고)실적. 반품은 qty가 음수
/// 중복 키: (date, productCode, slipNo) — 재업로드 시 같은 행은 건너뜀
model ShipmentHistory {
  id           Int      @id @default(autoincrement())
  productCode  String
  date         DateTime
  yearMonth    String // YYYY-MM (월별 집계용)
  customerCode String
  slipNo       String? // 전표번호
  shipType     String // 정상 | 반품
  salesType    String // 내수 | 외주출고 | 자가소비 | 샘플출고
  qtyUnits     Int // 출고수량 (낱개)
  qtyBox       Float // 출고수량 / 포장단위수량
  batchId      String?

  product  Product      @relation(fields: [productCode], references: [code])
  customer Customer     @relation(fields: [customerCode], references: [code])
  batch    UploadBatch? @relation(fields: [batchId], references: [id])

  @@unique([date, productCode, slipNo])
  @@index([productCode, date])
  @@index([customerCode, date])
  @@index([date])
  @@index([yearMonth])
}

/// 거래처 마스터. 판매실적에 거래선 코드가 없어 code = 거래선명
model Customer {
  code      String  @id
  name      String
  type       String  @default("B2C") // B2B | B2C
  typeSource String  @default("AUTO") // AUTO(출고 건수 기준 자동) | MANUAL(분류표 업로드)
  orderUnit String  @default("BOX") // VEHICLE | BOX
  isActive  Boolean @default(true)

  shipments ShipmentHistory[]
}

/// 차량 적재율 계산용 (F4)
model Vehicle {
  id         Int    @id @default(autoincrement())
  tonnage    Float
  capacityM3 Float
  kind       String
}

/// KOSIS 플라스틱제품 제조업 출하지수 (F5), CSV 수동 업로드
model ExternalIndex {
  yearMonth          String @id // YYYY-MM
  kosisShipmentIndex Float
}

/// 월별 집계 (F5·F6). 실적 업로드 때마다 전체 재계산
model MonthlyStat {
  id            Int    @id @default(autoincrement())
  productCode   String
  yearMonth     String // YYYY-MM
  qtyProduced   Int    @default(0) // A급, 전표구분 21+22
  qtyProdDefect Int    @default(0) // C급, 전표구분 21+22
  qtyShippedBox Float  @default(0) // 정상·내수만, 박스
  qtyShippedB2B Float  @default(0)
  qtyShippedB2C Float  @default(0)

  product Product @relation(fields: [productCode], references: [code])

  @@unique([productCode, yearMonth])
  @@index([yearMonth])
}
